---
import "../styles/palette.css";
import "../styles/site.css";
import Brand from "../components/Brand.astro";
import Header from "../components/Header.astro";
import { routes, withBase } from "../effects";

interface Props {
  title: string;
  description: string;
  section?: "home" | "index";
  notFound?: boolean;
}

const { title, description, section, notFound = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const homeUrl = withBase(routes.home);
---
<!doctype html>
<html lang="zh-Hans" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#fbfaf7" data-light="#fbfaf7" data-dark="#19222d" />
    <script is:inline>
      try {
        if (localStorage.getItem("formtempo-theme") === "dark") {
          document.documentElement.dataset.theme = "dark";
          const themeColor = document.querySelector('meta[name="theme-color"]');
          themeColor.content = themeColor.dataset.dark;
        }
      } catch {
        // Light remains available when storage is unavailable.
      }
    </script>
    <meta name="description" content={description} />
    {!notFound && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href={withBase("mark.svg")} />
    <link rel="stylesheet" href={withBase("fonts/fonts.css")} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip" href="#main">跳到正文</a>
    <Header section={section} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-left">
          <Brand />
          <p class="footer-meta">网页动效图鉴<br />MIT License</p>
        </div>
        <div class="footer-links">
          <a href={withBase(routes.index)}>动效图鉴</a>
          <a href={`${homeUrl}#preview`}>现场演示</a>
          <a href={`${homeUrl}#quickstart`}>源码示例</a>
          <a href="https://github.com/kanelogger/formtempo" target="_blank" rel="noopener">GitHub</a>
          <a href="https://github.com/kanelogger/formtempo/blob/main/LICENSE" target="_blank" rel="noopener">License</a>
        </div>
      </div>
    </footer>
  </body>
</html>
