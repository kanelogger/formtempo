---
import Arrow from "./Arrow.astro";
import { routes, withBase, type effects } from "../effects";

interface Props {
  effect: (typeof effects)[number];
}

const { effect } = Astro.props;
const effectUrl = withBase(routes.effect(effect.slug));
const exampleUrl = (implementation: string) => withBase(routes.example(effect.slug, implementation));
const artwork = "#driven-clip-reveal-home-clip";
---

<div class="compare-study" id="compare-stage">
  <div class="compare-pair">
    <figure class="compare-frame">
      <div class="compare-mat">
        <div class="compare-print compare-print--crop">
          <svg viewBox="0 0 760 430" aria-hidden="true" focusable="false">
            <use href={artwork} />
          </svg>
        </div>
      </div>
      <figcaption>
        <span>裁剪帧</span>
        <output id="compare-value" for="compare-range" aria-hidden="true">50%</output>
      </figcaption>
    </figure>
    <figure class="compare-frame">
      <div class="compare-mat">
        <div class="compare-print">
          <svg viewBox="0 0 760 430" aria-hidden="true" focusable="false">
            <use href={artwork} />
          </svg>
        </div>
      </div>
      <figcaption>
        <span>完整帧</span>
        <span class="compare-full">100%</span>
      </figcaption>
    </figure>
  </div>

  <div class="compare-controls">
    <label for="compare-range">裁剪进度</label>
    <div class="compare-scale">
      <span aria-hidden="true">0%</span>
      <input id="compare-range" type="range" min="0" max="100" value="50"
        aria-valuetext="50%" aria-describedby="compare-help" disabled />
      <span aria-hidden="true">100%</span>
    </div>
  </div>

  <div class="compare-notes">
    <div>
      <h3>{effect.title}</h3>
      <p>{effect.scene} 可用 <code>clip-path: inset()</code> 从中心打开可见范围。</p>
    </div>
    <nav class="compare-links" aria-label="裁剪展开案例与源码">
      <a class="compare-detail-link" href={effectUrl}>查看案例 <Arrow diagonal /></a>
      <a href={exampleUrl("native")}>原生 HTML</a>
      <a href={exampleUrl("gsap")}>GSAP HTML</a>
    </nav>
  </div>
</div>

<style>
  .compare-study {
    --compare-progress: 50%;
    --compare-track: linear-gradient(
      to right,
      var(--accent) 0 var(--compare-progress),
      var(--line-strong) var(--compare-progress) 100%
    );
  }

  .compare-pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(.65rem, 2.4vw, 2rem);
  }

  .compare-frame { min-width: 0; }

  .compare-mat {
    padding: clamp(.35rem, 1.45vw, 1.15rem);
    border: 1px solid var(--line-hi);
    border-radius: clamp(.55rem, 1vw, .85rem);
    background: var(--plate);
  }

  .compare-print {
    aspect-ratio: 760 / 430;
    display: grid;
    overflow: hidden;
    border-radius: 3px;
    background: var(--surface-2);
  }

  .compare-print svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .compare-print--crop svg {
    clip-path: inset(calc((100% - var(--compare-progress)) / 2));
  }

  .compare-frame figcaption {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: .3rem;
    margin-top: .75rem;
    padding-inline: .12rem;
    color: var(--text);
    font-size: .875rem;
  }

  .compare-frame :is(output, .compare-full), .compare-scale > span {
    font-family: var(--font-mono);
    font-size: .75rem;
    font-variant-numeric: tabular-nums;
  }

  .compare-frame output { color: var(--accent-text); }
  .compare-full, .compare-scale > span { color: var(--text-2); }

  .compare-controls {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    align-items: center;
    gap: .35rem clamp(.65rem, 3vw, 2.5rem);
    margin-block: clamp(1.5rem, 3vw, 2.25rem) 1.55rem;
    padding: .4rem clamp(.7rem, 2.4vw, 1.75rem);
    border-radius: 12px;
    background: var(--surface-2);
  }

  .compare-controls label { color: var(--text); font-size: .875rem; font-weight: 600; }

  .compare-scale {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr) 2.25rem;
    align-items: center;
    gap: .6rem;
  }

  .compare-scale > span:last-child { text-align: end; }

  .compare-scale input {
    width: 100%;
    min-width: 0;
    height: 44px;
    appearance: none;
    border-radius: 8px;
    background: transparent;
    cursor: ew-resize;
  }

  .compare-scale input:disabled { cursor: default; }
  .compare-scale input:focus-visible { outline-offset: -1px; }

  .compare-scale input::-webkit-slider-runnable-track {
    height: 3px;
    border-radius: 2px;
    background: var(--compare-track);
  }

  .compare-scale input::-moz-range-track {
    height: 3px;
    border-radius: 2px;
    background: var(--compare-track);
  }

  .compare-scale input::-webkit-slider-thumb {
    appearance: none;
    width: 18px;
    height: 18px;
    margin-top: -7.5px;
    border: 2px solid var(--accent);
    border-radius: 50%;
    background: var(--plate);
  }

  .compare-scale input::-moz-range-thumb {
    width: 14px;
    height: 14px;
    border: 2px solid var(--accent);
    border-radius: 50%;
    background: var(--plate);
  }

  .compare-notes {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: .6rem 2rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--line-hi);
  }

  .compare-notes h3 {
    margin-bottom: .4rem;
    color: var(--text);
    font: 500 1.1rem/1.35 var(--font-grot);
  }

  .compare-notes p {
    max-width: 68ch;
    color: var(--text-2);
    font-size: .875rem;
    line-height: 1.7;
    text-wrap: pretty;
  }

  .compare-notes code { color: var(--accent-text); font-size: .85em; }

  .compare-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 1.15rem;
  }

  .compare-links a {
    display: inline-flex;
    align-items: center;
    gap: .3rem;
    min-height: 44px;
    color: var(--text-2);
    font-size: .8125rem;
    white-space: nowrap;
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: .25em;
  }

  .compare-links a:hover, .compare-links .compare-detail-link { color: var(--accent-text); }
  .compare-links a:hover { text-decoration-color: currentColor; }
  .compare-links :global(svg) { width: .875rem; height: .875rem; flex: none; }

  @media (max-width: 520px) {
    .compare-controls { grid-template-columns: 1fr; gap: 0; padding-block: .65rem .1rem; }
    .compare-scale { grid-template-columns: 1.75rem minmax(0, 1fr) 2.1rem; gap: .35rem; }
    .compare-frame figcaption { font-size: .8125rem; }
  }
</style>
