---
import Brand from "./Brand.astro";
import { routes, withBase } from "../effects";

interface Props {
  section?: "home" | "index";
}

const { section } = Astro.props;
const homeUrl = withBase(routes.home);
const indexUrl = withBase(routes.index);
const links = [
  { title: "现场演示", url: `${homeUrl}#preview` },
  { title: "动效图鉴", url: indexUrl, current: section === "index" ? (Astro.url.pathname === indexUrl ? "page" : "location") : undefined },
  { title: "源码示例", url: `${homeUrl}#quickstart` },
  { title: "触发方式", url: `${homeUrl}#types` },
] as const;
---
<header>
  <nav class="site-nav" aria-label="主导航">
    <Brand navigation />
    <div class="nav-right">
      <div class="nav-links">
        {links.map((link) => <a class="nav-link" href={link.url} aria-current={"current" in link ? link.current : undefined}>{link.title}</a>)}
        <a class="nav-link" href="https://github.com/kanelogger/formtempo" target="_blank" rel="noopener">GitHub<span class="nav-stars" data-gh-stars hidden></span></a>
      </div>
      <button class="btn-theme" type="button" data-theme-toggle aria-label="切换到深色主题" aria-pressed="false" hidden>
        <svg class="theme-moon" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M13.5 9.6A5.8 5.8 0 0 1 6.4 2.5a5.8 5.8 0 1 0 7.1 7.1Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
        <svg class="theme-sun" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="3" stroke="currentColor" stroke-width="1.4"/><path d="M8 1.2v1.6M8 13.2v1.6M1.2 8h1.6M13.2 8h1.6M3.2 3.2l1.1 1.1M11.7 11.7l1.1 1.1M3.2 12.8l1.1-1.1M11.7 4.3l1.1-1.1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
      </button>
      <a class="btn btn-primary nav-cta" href={indexUrl}>浏览图鉴</a>
    </div>
  </nav>
</header>

<script>
  const root = document.documentElement;
  const meta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
  const toggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  const syncNav = () => document.body.classList.toggle("nav-scrolled", window.scrollY > 8);

  window.addEventListener("scroll", syncNav, { passive: true });
  syncNav();

  const syncTheme = () => {
    const dark = root.dataset.theme === "dark";
    if (meta) meta.content = meta.dataset[dark ? "dark" : "light"] ?? meta.content;
    toggle?.setAttribute("aria-label", dark ? "切换到浅色主题" : "切换到深色主题");
    toggle?.setAttribute("aria-pressed", String(dark));
  };

  if (toggle) {
    syncTheme();
    toggle.hidden = false;
    toggle.addEventListener("click", () => {
      const theme = root.dataset.theme === "dark" ? "light" : "dark";
      root.dataset.theme = theme;
      try {
        localStorage.setItem("formtempo-theme", theme);
      } catch {
        // The selected theme still applies to this page.
      }
      syncTheme();
      window.dispatchEvent(new CustomEvent("formtempo:themechange", { detail: { theme } }));
    });
  }

  const starsKey = "formtempo-gh-stars";

  function paintStars(count: number) {
    if (!count) return;
    const label = count >= 1000 ? `${(count / 1000).toFixed(count >= 10000 ? 0 : 1)}k` : String(count);
    for (const badge of document.querySelectorAll<HTMLElement>("[data-gh-stars]")) {
      badge.textContent = label;
      badge.setAttribute("aria-label", `${count} 颗星标`);
      badge.hidden = false;
    }
  }

  async function loadStars() {
    try {
      const cached = JSON.parse(sessionStorage.getItem(starsKey) || "null");
      if (cached && Date.now() - cached.at < 3_600_000) {
        paintStars(cached.count);
        return;
      }
    } catch {
      // Cache access is optional.
    }

    try {
      const response = await fetch("https://api.github.com/repos/kanelogger/formtempo");
      if (!response.ok) return;
      const { stargazers_count: count } = await response.json();
      if (typeof count !== "number") return;
      paintStars(count);
      sessionStorage.setItem(starsKey, JSON.stringify({ count, at: Date.now() }));
    } catch {
      // GitHub is still reachable through the navigation link.
    }
  }

  void loadStars();
</script>
