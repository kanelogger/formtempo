      <rect x="121" y="35" width="94" height="32" rx="6" fill="currentColor" fill-opacity=".14" />
      <path d="M146 60l24-17m-9 0h9v9M219 67l13 8-7 2-2 7z" />
    </g>
  )}
  {variant === 14 && (
    <g fill="none" stroke="currentColor" stroke-width={stroke}>
      <rect x="118" y="35" width="76" height="48" rx="4" />
      <rect x="109" y="28" width="94" height="62" rx="7" opacity=".65" />
      <rect x="100" y="21" width="112" height="76" rx="10" opacity=".28" />
      <path d="M72 59h38m-7-6 7 6-7 6M133 65h11l6-10 7 15 6-11h16" />
    </g>
  )}
  {variant === 15 && (
    <g fill="none" stroke="currentColor" stroke-width={stroke}>
      <rect x="96" y="17" width="120" height="84" rx="5" />
      <path d="M104 24h104v16H104zm0 54h104v16H104z" opacity=".38" />
      <rect x="104" y="45" width="104" height="28" rx="3" fill="currentColor" fill-opacity=".14" />
      <path d="M122 59h44m-44 6h26M230 28v62m-5-6 5 6 5-6" />
      <circle cx="230" cy="59" r="3" fill="currentColor" />
    </g>
  )}
  {variant === 16 && (
    <g fill="none" stroke="currentColor" stroke-width={stroke}>
      <rect x="54" y="29" width="91" height="60" rx="4" />
      <rect x="167" y="29" width="91" height="60" rx="4" />
      <rect x="77" y="44" width="45" height="30" rx="2" opacity=".55" />
      <path d="M77 66l20-19 25 20m-45 7h45" />
      <rect x="190" y="44" width="45" height="30" rx="2" />
      <path d="M192 69l12-10 10 6 8-7 11 11m-20-16h1" />
      <path d="M145 59h22" stroke-dasharray="2 3" opacity=".58" />
    </g>
  )}
  {variant === 17 && (
    <g fill="none" stroke="currentColor" stroke-width={stroke}>
      <rect x="49" y="29" width="66" height="43" rx="3" opacity=".55" />
