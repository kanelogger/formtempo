      <rect x="197" y="29" width="66" height="43" rx="3" opacity=".55" />
      <path d="M56 62l14-8 10 4 16-6 12 7m22 4 14-8 10 4 16-6 12 7m22 3 14-8 10 4 16-6 12 7" opacity=".64" />
      <circle cx="66" cy="45" r="4" fill="currentColor" />
      <circle cx="156" cy="45" r="5" fill="currentColor" />
      <circle cx="247" cy="45" r="4" fill="currentColor" />
      <path d="M64 87h184m-166-4v8m74-6v8m74-10v8" />
    </g>
  )}
  {variant === 18 && (
    <g fill="none" stroke="currentColor" stroke-width={stroke}>
      <rect x="54" y="29" width="91" height="60" rx="4" opacity=".55" />
      <rect x="167" y="29" width="91" height="60" rx="4" opacity=".55" />
      <rect x="77" y="44" width="45" height="30" fill="currentColor" stroke="none" />
      <g fill="currentColor" stroke="none">
        <rect x="182" y="37" width="61" height="44" rx="6" opacity=".12" />
        <rect x="186" y="40" width="53" height="38" rx="5" opacity=".22" />
        <rect x="190" y="44" width="45" height="30" rx="3" opacity=".46" />
        <rect x="194" y="48" width="37" height="22" rx="2" />
      </g>
    </g>
  )}
  {variant === 19 && (
    <g fill="none" stroke="currentColor" stroke-width={stroke}>
      <path d="M77 83l69-42m89 42-69-42" stroke-dasharray="3 4" opacity=".52" />
      <circle cx="156" cy="33" r="8" fill="currentColor" opacity=".68" />
      <path d="M134 69V48h44v21m-44-21 7-6h44v21l-7 6m0-21 7-6" />
      <path d="M104 86h104m-6-5 6 5-6 5" />
      <circle cx="104" cy="86" r="3" fill="currentColor" />
      <circle cx="156" cy="86" r="3" fill="currentColor" />
    </g>
  )}
  {variant === 20 && (
    <g fill="none" stroke="currentColor" stroke-width={stroke}>
      <rect x="72" y="25" width="76" height="68" rx="4" /><rect x="164" y="25" width="76" height="68" rx="4" fill="currentColor" fill-opacity=".14" />
      <circle cx="110" cy="49" r="12" /><path d="M88 76h44M178 45h48m-48 10h39m-39 10h44M148 59h16" />
    </g>
  )}
  {variant === 21 && (
    <g fill="none" stroke="currentColor" stroke-width={stroke}>
      <path d="m103 43 28-16 28 16v32l-28 16-28-16z M103 43l28 16 28-16m-28 16v32" />
      <path d="m190 37 20-12 20 12-20 12z M184 46v28l-20 12V58zm52 0v28l20 12V58z M190 82l20 12 20-12" />
    </g>
  )}
  {variant === 22 && (
    <g fill="none" stroke="currentColor" stroke-width={stroke}>
      <path d="M64 32h70v54H64z M178 32h70v54h-70z M139 59h34m-6-6 6 6-6 6" />
      <circle cx="99" cy="50" r="9" fill="currentColor" opacity=".5" /><path d="M74 79l20-17 20 17zm119-1 20-24 20 24z" />
    </g>
  )}
</svg>
