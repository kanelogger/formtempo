---
interface Props {
  slug: string;
  number: string;
  compact?: boolean;
}

const { slug, number, compact = false } = Astro.props;
const variant = Number(number);
const key = `notation-${slug}`;
const compactViewport = variant <= 3 || variant === 8 ? "58 12 196 94" : "38 12 236 94";
const viewport = compact ? compactViewport : "0 0 312 118";
const stroke = compact ? 2.6 : 1.5;
---
<svg class="notation" viewBox={viewport} aria-hidden="true" focusable="false">
  {!compact && (
    <>
      <defs>
        <pattern id={key} width="16" height="16" patternUnits="userSpaceOnUse">
          <path d="M16 0H0V16" fill="none" stroke="currentColor" opacity=".14" />
        </pattern>
      </defs>
      <rect width="312" height="118" fill={`url(#${key})`} />
      <g stroke="currentColor" opacity=".5" fill="none">
        <path d="M16 24V16h8M288 16h8v8M16 94v8h8m264 0h8v-8M156 10v7m0 84v7M10 59h7m278 0h7" />
        <path d="M30 59h250" stroke-dasharray="2 5" />
      </g>
    </>
  )}
  {variant <= 3 && (
    <g fill="none" stroke="currentColor" stroke-width={stroke}>
      <rect x="112" y="29" width="88" height="60" rx="2" />
      <path d="M121 38h69v42h-69z" opacity=".38" stroke-dasharray="3 3" />
      <path d={variant === 3 ? "M78 59h63m-8-6 8 6-8 6m23-47v29m-6-6 6 6 6-6m72 18h-55m8-6-8 6 8 6m-31 38V73m-6 6 6-6 6 6" : variant === 2 ? "M69 50h60m-7-6 7 6-7 6m58 14h60m-7-6 7 6-7 6" : "M74 50h62m-7-6 7 6-7 6m7 15H74m7-6-7 6 7 6"} />
      <rect x={variant === 3 ? 146 : 144} y="48" width="29" height="23" fill="currentColor" />
    </g>
  )}
  {variant >= 4 && variant <= 6 && (
    <g stroke="currentColor" stroke-width={stroke} fill="none">
      <path d="M82 21v76m148-76v76" stroke-dasharray="3 4" opacity=".55" />
      <path d={variant === 4 ? "M45 70h50l24-25h146" : variant === 5 ? "M45 70h50l24-25h146M121 76H76m8-5-8 5 8 5" : "M45 70h50l24-25h82l23 25h41M182 77h-48m8-5-8 5 8 5"} />
      <circle cx="82" cy="70" r="3" fill="currentColor" />
      <circle cx="230" cy={variant === 6 ? 70 : 45} r="3" fill="currentColor" />
    </g>
  )}
  {variant === 7 && (
    <g fill="none" stroke="currentColor" stroke-width={stroke}>
      <rect x="54" y="32" width="56" height="54" opacity=".55" />
      <rect x="75" y="52" width="14" height="14" fill="currentColor" />
      <path d="M126 59h53m-7-5 7 5-7 5" />
      <rect x="198" y="32" width="56" height="54" fill="currentColor" />
      <path d="m211 72 30-26m-30 16 22-19" stroke="var(--notation-cut, var(--plate))" opacity=".85" />
    </g>
  )}
  {variant === 8 && (
    <g fill="none" stroke="currentColor" stroke-width={stroke}>
      <path d="m79 69 42-31 93 0 22 30-54 24h-61z" opacity=".38" />
      <path d="m68 63 66-36h89l23 32-52 29h-73z" opacity=".65" />
      <path d="m63 54 80-36h87l20 33-56 29h-74z" />
      <path d="M105 95h95m-7-5 7 5-7 5" />
    </g>
  )}
  {variant === 9 && (
    <g fill="none" stroke="currentColor" stroke-width={stroke}>
      <rect x="108" y="23" width="96" height="72" />
      <path d="M45 36h54v47H45zm73 0h76v47h-76zm95 0h54v47h-54z" opacity=".45" />
      <path d="M71 60h171m-8-6 8 6-8 6m-155-12-8 6 8 6" />
    </g>
  )}
  {variant >= 10 && variant <= 12 && (
    <g fill="none" stroke="currentColor" stroke-width={stroke}>
      <rect x="62" y="30" width="75" height="60" rx="2" />
      <rect x="176" y="30" width="75" height="60" rx="2" />
      {variant === 10 && <path d="M109 44h92v32h-92z" fill="currentColor" />}
      {variant === 11 && <><rect x="113" y="38" width="56" height="46" fill="var(--notation-ground, var(--surface))" /><rect x="144" y="47" width="56" height="46" fill="currentColor" opacity=".72" /></>}
      {variant === 12 && <><rect x="72" y="41" width="23" height="22" fill="currentColor" /><rect x="190" y="42" width="46" height="36" fill="currentColor" /><path d="M100 51c34-12 54-9 84 7m-7-7 7 7-10 1" /></>}
    </g>
  )}
  {variant === 13 && (
    <g fill="none" stroke="currentColor" stroke-width={stroke}>
      <rect x="76" y="23" width="160" height="72" rx="6" opacity=".4" />
